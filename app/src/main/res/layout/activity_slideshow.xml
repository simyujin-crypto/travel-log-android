<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frameContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/imgSlide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:padding="14dp" />

    <VideoView
        android:id="@+id/videoSlide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 추억 액자 테두리 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="@drawable/memory_frame" />

    <!-- 하단 장소명 자막 (장소만 감성 서체로 출력) -->
    <TextView
        android:id="@+id/tvPlaceCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="84dp"
        android:gravity="center"
        android:padding="12dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <!-- 엔딩 크레딧 오버레이 -->
    <TextView
        android:id="@+id/tvEndingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:gravity="center"
        android:lineSpacingExtra="10dp"
        android:padding="28dp"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveMp4"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="#7F1D1D"
        android:text="MP4 영상 저장"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</FrameLayout>