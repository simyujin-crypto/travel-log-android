<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frameContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/imgSlide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:padding="16dp" />

    <VideoView
        android:id="@+id/videoSlide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 구글 지도 웹뷰 (경로 및 마커 표시용) -->
    <WebView
        android:id="@+id/webMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 추억 액자 테두리 (터치 통과 설정) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:background="@drawable/memory_frame"
        android:clickable="false"
        android:focusable="false" />

    <!-- 하단 장소명 자막 (장소만 감성 서체로 표시) -->
    <TextView
        android:id="@+id/tvPlaceCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="92dp"
        android:background="#88000000"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#FFF8E7"
        android:textSize="22sp" />

    <!-- 엔딩 크레딧 오버레이 -->
    <TextView
        android:id="@+id/tvEndingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB000000"
        android:gravity="center"
        android:lineSpacingExtra="10dp"
        android:padding="28dp"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggleMap"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#1E293B"
            android:text="구글지도 보기"
            android:textColor="#D4AF37"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSaveMp4"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#7F1D1D"
            android:text="MP4 영상 저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>