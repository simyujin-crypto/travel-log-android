<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⛰️ 나의 여행 및 등산 기록지"
            android:textColor="#D4AF37"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목적 (제목)"
            android:textColor="#D4AF37" />
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="속리산등반"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일시"
            android:textColor="#D4AF37" />
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026.11.16"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="동반자 (쉼표로 구분)"
            android:textColor="#D4AF37" />
        <EditText
            android:id="@+id/etCompanions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="구주연"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정 선택"
            android:textColor="#D4AF37" />
        <Spinner
            android:id="@+id/spSchedule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="출발지 및 시간"
            android:textColor="#D4AF37" />
        <EditText
            android:id="@+id/etDeparture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="메가커피수원대점 오전10시"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="숙박지"
            android:textColor="#D4AF37" />
        <EditText
            android:id="@+id/etLodging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="없음"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D4AF37"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSelectCover"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="1. 대표 표지 이미지 선택"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSelectMedia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="2. 여행 사진 및 영상 다중 선택"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="선택된 사진/영상: 0개"
            android:textColor="#94A3B8"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnStartSlideshow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="3. 경로 분석 및 슬라이드쇼 시작"
            android:backgroundTint="#D4AF37"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>